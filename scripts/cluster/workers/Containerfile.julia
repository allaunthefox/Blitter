# LSP worker image: Julia language server entrypoint.
#
# BOOTSTRAP BASE: placeholder digest; production must rebuild from a reviewed
# base and record the published ref in the deployment-owned image policy.
# Canonical argv (must match lsp_workers.CANONICAL_COMMANDS["julia"]):
#   julia --startup-file=no
FROM docker.io/library/julia:1.11-bookworm@sha256:bc8d1c90753a3cd639a78d445f141b003a2cf10ba948daf29c60452cf1617139

# Reproducible build: pin the Julia base image digest and the LanguageServer
# package version. Julia's Pkg can pin to a specific version UUID.
ARG JULIA_LANGUAGESERVER_COMMIT=9e9993c39b3b55f36ba18c37da44009ec8d8e7be

RUN julia --startup-file=no -e 'using Pkg; Pkg.add(name="LanguageServer", rev="master")' \
    && julia --startup-file=no -e 'print(VERSION)' \
    && useradd --uid 65532 --user-group --no-create-home --shell /usr/sbin/nologin lsp \
    && mkdir -p /workspace && chown 65532:65532 /workspace

USER 65532:65532
WORKDIR /workspace/source
HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
    CMD ["julia", "--startup-file=no", "-e", "print(VERSION)"]
CMD ["julia", "--startup-file=no"]
